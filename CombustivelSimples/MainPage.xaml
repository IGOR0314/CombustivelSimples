<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CombustivelSimples.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="15">

            <Label Text="Marca do Veículo" />
            <Entry x:Name="txtMarca" Placeholder="Ex: Fiat" />

            <Label Text="Modelo do Veículo" />
            <Entry x:Name="txtModelo" Placeholder="Ex: Uno" />

            <Label Text="Preço do Etanol" />
            <Entry x:Name="txtEtanol" Placeholder="Ex: 3.50" Keyboard="Numeric" />

            <Label Text="Preço da Gasolina" />
            <Entry x:Name="txtGasolina" Placeholder="Ex: 5.50" Keyboard="Numeric" />

            <Button Text="Qual compensa mais?" Clicked="Button_Clicked"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
